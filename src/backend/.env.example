# ============================================================
# FECAP Guia — Variaveis de Ambiente de EXEMPLO
# ============================================================
# ATENCAO: Copie para .env e edite. NUNCA commite .env!
# ============================================================

# ----- APLICACAO -----
APP_NAME="FECAP Guia"
APP_VERSION="1.0.0"
APP_ENV=development
DEBUG=true

# ----- BANCO DE DADOS -----
# SQLite (desenvolvimento local - padrao)
DATABASE_URL=sqlite:///./fecap_guia.db

# PostgreSQL (producao) - descomente e ajuste:
# DATABASE_URL=postgresql://fecap_user:fecap_pass@db:5432/fecap_guia

# ----- AUTENTICACAO JWT -----
# Gere: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=SUBSTITUA_POR_UMA_CHAVE_SEGURA_GERADA_LOCALMENTE
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ----- AGENTE DE IA -----
# Modos: demo | gemini
# Use "demo" para funcionar sem API key (100% local)
LLM_MODE=demo

# ----- GOOGLE GEMINI (so se LLM_MODE=gemini) -----
# Obtenha em: https://aistudio.google.com/
GOOGLE_API_KEY=SUA_CHAVE_AQUI
GEMINI_MODEL=gemini-1.5-flash

# ----- PARAMETROS DO AGENTE -----
AGENT_TEMPERATURE=0.1
AGENT_MAX_TOKENS=2048
AGENT_TOP_K_DOCUMENTS=5
AGENT_CONFIDENCE_THRESHOLD=0.4
AGENT_MIN_EVIDENCE_SCORE=0.35
AGENT_VERSION=1.0.0
AGENT_FALLBACK_MESSAGE="Nao encontrei informacao oficial suficiente na base de conhecimento para responder com seguranca. Recomendo encaminhar sua solicitacao para atendimento humano."

# ----- EMBEDDINGS -----
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# ----- CHROMADB -----
CHROMA_PERSIST_DIRECTORY=./chroma_db
CHROMA_COLLECTION_NAME=fecap_knowledge

# ----- IMPORTACAO DE DOCUMENTOS -----
MAX_DOCUMENT_SIZE_MB=10
ALLOWED_DOCUMENT_TYPES=pdf,txt,docx
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ----- LOGS -----
LOG_LEVEL=INFO

# ----- CORS -----
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ----- ADMIN DEMO -----
ADMIN_DEFAULT_EMAIL=admin@demo.fecap.br
ADMIN_DEFAULT_PASSWORD=ALTERE_ESTA_SENHA_EM_PRODUCAO
